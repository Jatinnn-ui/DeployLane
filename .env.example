###############################################################################
# DeployLane - environment configuration
#
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. NEVER commit real secrets.
###############################################################################

# --------------------------------------------------------------------------- #
# Database (PostgreSQL)
# --------------------------------------------------------------------------- #
POSTGRES_DB=deployforge
POSTGRES_USER=deployforge
POSTGRES_PASSWORD=deployforge_local_password
POSTGRES_PORT=5432

# JDBC URL used by the backend.
# - running backend from your IDE / host:      jdbc:postgresql://localhost:5432/deployforge
# - running backend inside docker compose:     jdbc:postgresql://postgres:5432/deployforge
DATABASE_URL=jdbc:postgresql://localhost:5432/deployforge
DATABASE_USERNAME=deployforge
DATABASE_PASSWORD=deployforge_local_password

# --------------------------------------------------------------------------- #
# Redis (deployment queue, rate limiting, OAuth state, refresh tokens)
# --------------------------------------------------------------------------- #
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------------------------------------------------------- #
# Security
# --------------------------------------------------------------------------- #
# JWT signing secret. Minimum 32 bytes. Generate with:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_long_random_value_at_least_32_bytes_long

# Application level encryption key for secrets at rest (AES-256-GCM).
# MUST be a base64 encoded 32 byte key. Generate with:
#   openssl rand -base64 32
# Losing this key makes every stored secret unrecoverable.
ENCRYPTION_KEY=CHANGE_ME_base64_encoded_32_byte_key

# --------------------------------------------------------------------------- #
# GitHub OAuth application
# Create at: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:8080/api/v1/auth/github/callback
# --------------------------------------------------------------------------- #
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Shared secret configured on the GitHub webhook. Required for auto deploys.
GITHUB_WEBHOOK_SECRET=

# --------------------------------------------------------------------------- #
# AI provider
# AI_PROVIDER: gemini | openai | heuristic
#   heuristic = no external calls, local rule based analyzer (offline demo mode)
# --------------------------------------------------------------------------- #
AI_PROVIDER=heuristic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------------------------- #
# URLs / routing
# --------------------------------------------------------------------------- #
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8080

# Where cloned repositories and build contexts are written.
# Windows example: C:/deployforge/builds
DEPLOYMENT_ROOT_PATH=./data/builds

# Host used to build deployment URLs for locally published container ports.
DEPLOYMENT_PUBLIC_HOST=localhost
# Host port range reserved for deployed application containers.
DEPLOYMENT_PORT_RANGE_START=30000
DEPLOYMENT_PORT_RANGE_END=30999

# --------------------------------------------------------------------------- #
# Routing mode
#   local   = publish container on host port (default, for development)
#   traefik = assign subdomains via Traefik reverse proxy (for production)
# --------------------------------------------------------------------------- #
DEPLOYMENT_ROUTING_MODE=local
# Base domain for Traefik routing. Required when DEPLOYMENT_ROUTING_MODE=traefik.
# Example: deploylane.app → each project gets <slug>.deploylane.app
DEPLOYMENT_BASE_DOMAIN=

# --------------------------------------------------------------------------- #
# Docker engine
#   Linux / macOS : unix:///var/run/docker.sock
#   Windows       : npipe:////./pipe/docker_engine
#   Inside compose: unix:///var/run/docker.sock (socket must be mounted)
# --------------------------------------------------------------------------- #
DOCKER_HOST_URI=npipe:////./pipe/docker_engine

# Resource limits applied to every deployed application container.
DEPLOYMENT_MEMORY_LIMIT_MB=1024
DEPLOYMENT_CPU_LIMIT=1.0
DEPLOYMENT_PIDS_LIMIT=256
DEPLOYMENT_BUILD_TIMEOUT_SECONDS=900

# --------------------------------------------------------------------------- #
# Frontend (Vite) - only VITE_ prefixed values reach the browser
# --------------------------------------------------------------------------- #
VITE_API_BASE_URL=http://localhost:8080
